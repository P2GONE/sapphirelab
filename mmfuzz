#!/usr/bin/env bash
# Convenience launcher for the multimodal jailbreak fuzzer.
# Forwards every argument to mmfuzz.py. Override the interpreter via $PYTHON
# (e.g. PYTHON=./venv/bin/python ./mmfuzz ...).
set -e
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="${PYTHON:-python3}"
exec "$PY" "$DIR/mmfuzz.py" "$@"
