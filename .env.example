# Windows에서 한글 출력 깨짐 방지 (Windows 사용 시 항상 설정)
PYTHONUTF8=1

# ── Image fuzzer / Gemini 뮤테이터 ────────────────────────────────────────────
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash

# ── 텍스트 뮤테이터 (fuzzer.cfg Mutation.Provider에 맞춰 설정) ─────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── 쇼핑몰 챗봇 직접 호출 (옵션) ─────────────────────────────────────────────
# CHATBOT_ENDPOINT=https://YOUR-TARGET.ngrok-free.app/api/chat
# CHATBOT_API_KEY=

# ── Image fuzzer 실행 옵션 ────────────────────────────────────────────────────
REQUEST_DELAY_SEC=4.0
MAX_RETRIES=3
SAVE_MUTATED_IMAGES=true
